# See smart-scheduler-front/.env.example
NEXT_PUBLIC_API_URL=https://som.develyst.online/api
# Set to "true" to use in-memory mock (no backend required)
NEXT_PUBLIC_USE_MOCK=false
# NextAuth (Auth.js v5) — generate with: openssl rand -base64 32
AUTH_SECRET=xxxxx
# Auth.js v5 — base URL of the frontend (where NextAuth handler lives at /api/auth/*)
AUTH_URL=https://som.develyst.online/api
# TASK-348 (REQ-088) — the /register page's LIFF app ID, from the CUSTOMER's LINE Developers console (per
# environment). Must be NEXT_PUBLIC_ to reach the browser bundle. Absent ⇒ the page shows a message, not a blank.
# (The server's LINE_LOGIN_CHANNEL_ID is separate and the page never sees it.)
NEXT_PUBLIC_LIFF_ID=
